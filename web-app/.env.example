# Copy to .env.local and adjust.

# Public URL used in email links.
APP_URL=http://localhost:3000

# Postgres from docker-compose.yml (`docker compose up -d`).
# Leave empty to use the built-in PGlite database instead (data in .data/).
DATABASE_URL=postgres://moodboard:moodboard@localhost:5432/moodboard

# Mailpit from docker-compose.yml: inbox at http://localhost:8025.
# Leave empty to save emails to .mail/ instead (viewable at /admin/outbox).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ReferenceMePlzQQ <no-reply@localhost>"

# Where uploaded photos are stored (default: ./uploads).
UPLOAD_DIR=

# Optional overrides for the PGlite and outbox folders (the e2e tests use these).
PGLITE_DIR=
MAIL_DIR=
