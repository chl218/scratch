{"nodes": [{"id": "ig_scraper_readme_igdl", "label": "igdl: Instagram post downloader", "file_type": "document", "source_file": "ig-scraper/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_instaloader", "label": "instaloader", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_piexif", "label": "piexif (EXIF writer)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_gui_window", "label": "Desktop GUI window (main-program.py, tkinter)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses only built-in tkinter so it needs nothing beyond igdl's own dependencies; runs downloader on a background thread so Stop works mid-download and during rate-limit pauses."}, {"id": "ig_scraper_readme_cli_module", "label": "cli.py (argument parsing, exit codes)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_downloader_module", "label": "downloader.py (build_loader, download_user)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_tags_module", "label": "tags.py (extract_hashtags, write_tags)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_security_module", "label": "security.py (username check, strip_control)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_hashtag_exif_tags", "label": "Caption hashtags written to EXIF XPKeywords Tags", "file_type": "rationale", "source_file": "ig-scraper/README.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XPKeywords is where Windows itself stores Tags, so they show in Explorer Properties/Details and are searchable; image is not re-encoded, so quality and date are unchanged. Duplicates dropped case-insensitively."}, {"id": "ig_scraper_readme_pinned_posts_limit", "label": "--limit with pinned posts (MAX_PINNED = 3)", "file_type": "rationale", "source_file": "ig-scraper/README.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instagram lists up to 3 pinned posts first regardless of date; reading N+3 and sorting by date keeps old pinned posts from taking the N newest slots."}, {"id": "ig_scraper_readme_images_only_default", "label": "Images-only default download filter", "file_type": "rationale", "source_file": "ig-scraper/README.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Video posts are dropped before --limit counts; build_loader disables video files and thumbnails so carousel video slides are skipped too."}, {"id": "ig_scraper_readme_download_pipeline", "label": "Download pipeline", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_terminal_safety", "label": "Terminal safety (strip control characters)", "file_type": "rationale", "source_file": "ig-scraper/README.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All output, including instaloader caption previews, passes through strip_control so captions cannot inject terminal escape codes."}, {"id": "ig_scraper_readme_exit_codes", "label": "igdl exit codes", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_rate_limit_pauses", "label": "Instagram rate-limit pauses", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ig_scraper_readme_public_profiles_only", "label": "Public profiles only (no login)", "file_type": "rationale", "source_file": "ig-scraper/README.md", "source_location": "L209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No login is supported, so private profiles return exit code 2; login-failed code 3 retired. Scraping is against Instagram ToS, so use only with permission."}, {"id": "ig_scraper_readme_resumable_downloads", "label": "Resumable downloads (skip existing files)", "file_type": "concept", "source_file": "ig-scraper/README.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ig_scraper_readme_igdl", "target": "ig_scraper_readme_instaloader", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ig-scraper/README.md", "source_location": "L3", "weight": 1.0}, {"source": "ig_scraper_readme_igdl", "target": "ig_scraper_readme_gui_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ig-scraper/README.md", "source_location": "L29", "weight": 1.0}, {"source": "ig_scraper_readme_igdl", "target": "ig_scr